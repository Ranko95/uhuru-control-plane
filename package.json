{
  "name": "uhuru-control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "start": "node src/server.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "sh test/run.sh",
    "db:prepare": "docker compose -f docker-compose.local.yml up -d --wait && echo uhuru | PGHOST=127.0.0.1 PGUSER=postgres PGPASSWORD=uhuru node deploy/db-setup.ts",
    "db:migration:create": "node-pg-migrate create --migration-file-language sql --migration-filename-format utc"
  },
  "dependencies": {
    "config": "5.0.1",
    "fastify": "5.12.5",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "eslint": "^10.11.0",
    "prettier": "3.9.8",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
